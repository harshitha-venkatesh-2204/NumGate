% arxiv.sty: a plain arXiv preprint layout for NumGate (Times, title between rules,
% "A Preprint" running header, keywords line). Written for this paper; uses only
% packages that ship with TeX Live, so arXiv can compile it.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{arxiv}[2026/10/17 NumGate arXiv preprint layout]

\RequirePackage[letterpaper,margin=1in,headheight=14pt,headsep=18pt]{geometry}
\RequirePackage{newtxtext}
\RequirePackage{newtxmath}
\RequirePackage{fancyhdr}
\RequirePackage{url}

% captions sit above tables, so leave a gap below them instead of above
\setlength{\abovecaptionskip}{2pt}
\setlength{\belowcaptionskip}{6pt}

\gdef\@runningtitle{}
\gdef\@projecturl{}
\gdef\@codeurl{}
\newcommand{\runningtitle}[1]{\gdef\@runningtitle{#1}}
\newcommand{\projecturl}[1]{\gdef\@projecturl{#1}}
\newcommand{\codeurl}[1]{\gdef\@codeurl{#1}}

% Keywords, separated by \and inside the argument.
\newcommand{\keywords}[1]{%
  \par\vspace{0.8em}\noindent{\small\textbf{Keywords}\enspace
  {\def\and{\unskip\enspace$\cdot$\enspace\ignorespaces}#1}}\par}

% Running header on every page but the first.
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\itshape\@runningtitle}
\fancyhead[R]{\small\scshape A Preprint}
\fancyfoot[C]{\small\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\small\thepage}\renewcommand{\headrulewidth}{0pt}}

% Title block: title between a heavy and a light rule, then author, project page and date.
\renewcommand{\maketitle}{%
  \thispagestyle{plain}%
  \begin{center}
    \rule{\linewidth}{2pt}\par\vspace{0.7em}%
    {\LARGE\bfseries\@title\par}%
    \vspace{0.6em}\rule{\linewidth}{0.6pt}\par\vspace{1.3em}%
    {\large\bfseries\@author\par}%
    \ifx\@projecturl\@empty\else\vspace{0.3em}{\small Project page: \url{\@projecturl}\par}\fi
    \ifx\@codeurl\@empty\else{\small Code and data: \url{\@codeurl}\par}\fi
    \vspace{0.6em}{\small\scshape A Preprint\enspace$\cdot$\enspace\@date\par}%
  \end{center}%
  \vspace{1.2em}}

\endinput
